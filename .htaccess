RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.alproseltech\.com [NC]
RewriteRule ^ https://alproseltech.com%{REQUEST_URI} [L,R=301]

# Redirect all old pages to homepage
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !^/?$
RewriteRule ^ / [L,R=301]
